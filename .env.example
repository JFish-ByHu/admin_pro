# 应用端口
PORT=3001

# JWT 密钥（示例值，实际请替换）
JWT_ACCESS_SECRET=replace-with-your-access-secret
JWT_REFRESH_SECRET=replace-with-your-refresh-secret

# 邮箱验证码安全哈希盐（必须填写，建议 32 位以上随机字符串）
EMAIL_CODE_HASH_SECRET=

# 163 SMTP 配置（必须填写）
EMAIL_SMTP_HOST=smtp.163.com
EMAIL_SMTP_PORT=
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=YOUR_EMAIL
EMAIL_SMTP_PASS=
EMAIL_FROM=

# 上传存储配置
UPLOAD_ROOT_DIR=upload
UPLOAD_AVATAR_DIR=avatars
UPLOAD_STATIC_PREFIX=/api/upload
UPLOAD_AVATAR_MAX_SIZE=2097152
UPLOAD_PUBLIC_BASE_URL=
